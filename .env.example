# ============================================================
# Vision Attribute Pipeline — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Milvus ───────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ── API Server ───────────────────────────────────────────────
API_PORT=8000
API_SECRET=change-me-in-production
API_DEV_MODE=true

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/tmp/vap_logs

# ── Camera Sources ────────────────────────────────────────────
# Space-separated list of "camera_id:source_url" pairs
# Source can be RTSP URL or video file path
# Examples:
#   cam01:rtsp://admin:pass@192.168.1.10:554/stream1
#   cam02:rtsp://192.168.1.11/live
#   test:/app/test_data/sample.mp4
CAMERA_SOURCES=test:/app/test_data/sample.mp4

# ── AWS (for EC2 deployment) ──────────────────────────────────
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
