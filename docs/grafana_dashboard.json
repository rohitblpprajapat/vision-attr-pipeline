{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Vision Attribute Pipeline — Production Monitoring Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Pipeline Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "fps",
          "thresholds": { "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 10 },
            { "color": "green", "value": 25 }
          ]}
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal" },
      "targets": [
        {
          "expr": "rate(vap_frames_ingested_total[1m])",
          "legendFormat": "{{camera_id}}",
          "refId": "A"
        }
      ],
      "title": "Frame Ingest Rate (FPS per camera)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "rate(vap_detections_total[1m])",
          "legendFormat": "{{camera_id}}",
          "refId": "A"
        }
      ],
      "title": "Person Detections / second",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "targets": [
        {
          "expr": "rate(vap_par_crops_total[1m])",
          "legendFormat": "PAR crops/s",
          "refId": "A"
        },
        {
          "expr": "rate(vap_milvus_inserts_total[1m])",
          "legendFormat": "Milvus inserts/s",
          "refId": "B"
        }
      ],
      "title": "PAR + Storage Throughput",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 10,
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 11,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(vap_detection_latency_seconds_bucket[1m])) * 1000",
          "legendFormat": "Detection P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(vap_detection_latency_seconds_bucket[1m])) * 1000",
          "legendFormat": "Detection P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, rate(vap_par_latency_seconds_bucket[1m])) * 1000",
          "legendFormat": "PAR P50",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, rate(vap_par_latency_seconds_bucket[1m])) * 1000",
          "legendFormat": "PAR P95",
          "refId": "D"
        }
      ],
      "title": "Inference Latency (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 12,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(vap_search_latency_seconds_bucket[1m])) * 1000",
          "legendFormat": "Search P50 ({{query_type}})",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(vap_search_latency_seconds_bucket[1m])) * 1000",
          "legendFormat": "Search P99 ({{query_type}})",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, rate(vap_milvus_insert_latency_seconds_bucket[1m])) * 1000",
          "legendFormat": "Milvus Insert P50",
          "refId": "C"
        }
      ],
      "title": "Query + Storage Latency (ms)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 20,
      "title": "Queue Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 1000 },
            { "color": "red", "value": 4000 }
          ]},
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 19 },
      "id": 21,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "vap_redis_stream_length",
          "legendFormat": "{{stream_name}}",
          "refId": "A"
        }
      ],
      "title": "Redis Stream Lengths",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 100 },
            { "color": "red", "value": 1000 }
          ]},
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 19 },
      "id": 22,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "vap_redis_stream_lag",
          "legendFormat": "{{stream_name}} / {{group_name}}",
          "refId": "A"
        }
      ],
      "title": "Consumer Group Lag",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 30,
      "title": "GPU + Storage",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 90 }
          ]},
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 26 },
      "id": 31,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "vap_gpu_utilization_pct",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "title": "GPU Utilization %",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 12000 },
            { "color": "red", "value": 15000 }
          ]},
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 26 },
      "id": 32,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "vap_gpu_memory_used_mb",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "title": "GPU VRAM Used (MB)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 26 },
      "id": 33,
      "targets": [
        {
          "expr": "vap_milvus_entities_total",
          "legendFormat": "Total entities",
          "refId": "A"
        }
      ],
      "title": "Milvus Entity Count",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 26 },
      "id": 34,
      "targets": [
        {
          "expr": "vap_active_live_queries",
          "legendFormat": "Active queries",
          "refId": "A"
        },
        {
          "expr": "increase(vap_alerts_fired_total[5m])",
          "legendFormat": "Alerts (5m) - {{query_id}}",
          "refId": "B"
        }
      ],
      "title": "Live Queries + Alerts",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 40,
      "title": "Errors",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 33 },
      "id": 41,
      "targets": [
        {
          "expr": "increase(vap_worker_errors_total[5m])",
          "legendFormat": "{{worker_type}}-{{worker_id}}",
          "refId": "A"
        },
        {
          "expr": "increase(vap_redis_errors_total[5m])",
          "legendFormat": "Redis errors ({{worker_type}})",
          "refId": "B"
        }
      ],
      "title": "Worker Errors (5m window)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["vap", "computer-vision", "surveillance"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Vision Attribute Pipeline",
  "uid": "vap-main-dashboard",
  "version": 1
}
